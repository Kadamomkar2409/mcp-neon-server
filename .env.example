# Server Configuration
NODE_ENV=development
PORT=3000
MCP_TRANSPORT=streamable-http

# Neon PostgreSQL Database Connection (never commit actual connection string)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secret (HMAC secret for JWT verification and signing)
AUTH_SECRET=your_super_secret_jwt_auth_key_min_32_chars

# Logging
LOG_LEVEL=info
